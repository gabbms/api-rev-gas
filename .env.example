# Copie para .env e preencha. Nunca commite o .env.

# Banco (docker compose)
DATABASE_URL=postgres://revgas:revgas@localhost:5433/revgas_bot
DATABASE_URL_TEST=postgres://revgas:revgas@localhost:5433/revgas_bot_test

# RevGás
REVGAS_API_KEY=
REVGAS_BASE_URL=https://api.revgas.com/v1
REVGAS_ESTABLISHMENT_ID=2580
# Manter false até a RevGás liberar a criação de vendas reais
REVGAS_WRITE_ENABLED=false
# Busca de clientes na RevGás (GET /customers). O token atual recebe 403; manter false
REVGAS_CUSTOMERS_ENABLED=false
# Opcional: só oferecer estes produtos (e os vasilhames deles). Vazio = todos com acordo de preço.
# Exemplo: GLP 13kg, GLP 45kg e água 10L
REVGAS_PRODUCT_IDS=23740,23974,24141
REVGAS_BROADCAST=NONE

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Servidor
PORT=3333
MAX_ITEM_QUANTITY=10
