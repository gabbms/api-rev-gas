# Copie para .env e preencha. Nunca commite o .env.

# Banco (docker compose)
DATABASE_URL=postgres://revgas:revgas@localhost:5433/revgas_bot
DATABASE_URL_TEST=postgres://revgas:revgas@localhost:5433/revgas_bot_test

# RevGás
REVGAS_API_KEY=
REVGAS_BASE_URL=https://api.revgas.com/v1
REVGAS_ESTABLISHMENT_ID=2580
# Manter false até a RevGás liberar a criação de vendas reais
REVGAS_WRITE_ENABLED=false
# Busca de clientes na RevGás (GET /customers). O token atual recebe 403; manter false
REVGAS_CUSTOMERS_ENABLED=false
# Vale Gás: só depois da RevGás confirmar que o código do cupom vai em payments[].serial
REVGAS_VALEGAS_ENABLED=false
# Preço do cliente > da categoria > geral. Só tem efeito com REVGAS_CUSTOMERS_ENABLED=true
REVGAS_PRICE_PRIORITY=false
# Cidade/UF de entrega assumidas quando o cliente não diz outra (o bot não pergunta)
DEFAULT_CITY=Teresina
DEFAULT_STATE=PI
# Opcional: só oferecer estes produtos (e os vasilhames deles). Vazio = todos com acordo de preço.
# Exemplo: GLP 13kg, GLP 45kg e água 10L
REVGAS_PRODUCT_IDS=23740,23974,24141
REVGAS_BROADCAST=NONE

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# WhatsApp pelo WAHA (NÃO oficial, só para a demonstração; guia em docs/WAHA.md)
# off = só o chat simulado. waha = recebe e responde pelo chip conectado ao WAHA.
WHATSAPP_PROVIDER=off
WAHA_URL=http://localhost:3002
# Os dois são obrigatórios com waha. Gere textos longos e aleatórios (docs/WAHA.md)
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
WAHA_SESSION=default
# Porta do servidor que recebe o webhook do WAHA (só a rota POST /webhooks/waha)
WHATSAPP_WEBHOOK_PORT=3334
# Opcional: só estes números (DDD + número, separados por vírgula) usam o bot. Vazio = qualquer um
WHATSAPP_ALLOWED_NUMBERS=

# Transcrição de áudio do WhatsApp. off = responde "entendo só texto". groq = transcreve pela Groq
# (o áudio do cliente vai para a Groq). Com groq, exige GROQ_API_KEY e WHATSAPP_PROVIDER=waha.
AUDIO_TRANSCRIPTION=off
GROQ_API_KEY=
TRANSCRIBE_URL=https://api.groq.com/openai/v1/audio/transcriptions
TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Áudio maior que isto (em bytes; 2000000 ≈ 3 a 4 minutos de nota de voz) não é transcrito
AUDIO_MAX_BYTES=2000000

# Servidor
PORT=3333
MAX_ITEM_QUANTITY=10
